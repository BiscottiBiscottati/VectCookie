{
  "name": "vectfox-tests",
  "version": "1.0.0",
  "description": "Automated tests for VectFox RAG extension",
  "type": "module",
  "scripts": {
    "check": "npm run check:syntax && vitest run",
    "check:syntax": "node scripts/check-syntax.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "node scripts/run-e2e-logged.mjs",
    "test:e2e:no-log": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "jieba-wasm": "^2.4.0",
    "jsdom": "^27.0.1",
    "vitest": "^3.2.7"
  }
}
